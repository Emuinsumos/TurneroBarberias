rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Fotos de cada barbería: las ve cualquiera, solo las sube/borra el admin de ESA barbería.
    match /businesses/{b}/media/{file} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.token.role == 'admin'
        && request.auth.token.businessId == b
        && request.resource.size < 1024 * 1024
        && request.resource.contentType.matches('image/(webp|jpeg|png)');
      allow delete: if request.auth != null
        && request.auth.token.role == 'admin'
        && request.auth.token.businessId == b;
    }
  }
}
